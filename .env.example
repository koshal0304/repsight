# RepSight local environment (05 §4.5; names follow 02 Appendix A).
# Copy to .env (git-ignored) and fill local values. Never commit secrets (GR-12).
# Deployed environments read secrets from AWS Secrets Manager, not from a file.
# Empty values are secrets or optional services: set them only when you need them.

# --- Environment
ENV=local
CELL_ID=us-east-1
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
API_BASE_URL=http://localhost:8000/v1

# --- Database and cache
DATABASE_URL=postgresql+asyncpg://rs_app:rs_app@localhost:5432/repsight
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
VALKEY_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Encryption and signing (LocalStack KMS locally)
KMS_KEY_HEALTH_ARN=arn:aws:kms:us-east-1:000000000000:alias/rs-health-local
KMS_KEY_CHAT_ARN=arn:aws:kms:us-east-1:000000000000:alias/rs-chat-local
KMS_KEY_PII_ARN=arn:aws:kms:us-east-1:000000000000:alias/rs-pii-local
KMS_SIGNING_KEY_ARN=arn:aws:kms:us-east-1:000000000000:alias/repsight-config-signing
# JSON list of accepted verification keys: [{"kid":"local-a","pem":"-----BEGIN PUBLIC KEY-----..."}]
CONTENT_PUBLIC_KEYS=

# --- Auth (local-dev is refused when ENV is not local)
COGNITO_USER_POOL_ID=us-east-1_localpool
COGNITO_APP_CLIENT_ID=localclient
COGNITO_ADMIN_POOL_ID=us-east-1_localadmin
AUTH_MODE=local-dev

# --- LLM (CI and local default to recorded fixtures)
ANTHROPIC_API_KEY=
ANTHROPIC_INFERENCE_GEO=global
LLM_MODE=mock
LLM_ROUTE_CONFIG_PATH=services/api/config/llm_routes.local.yaml
LLM_MAX_TOOL_ROUNDS=6
LLM_SEMAPHORE_CHAT=200
LLM_SEMAPHORE_BACKGROUND=50
COACH_MAX_MESSAGE_CHARS=2000
COACH_MAX_MESSAGES_PER_HOUR=30
COST_BREAKER_USER_MULTIPLIER=5
KB_TOP_K=6
KB_MIN_SIMILARITY=0.30
EMBEDDING_MODEL_PATH=./.models/embed.onnx

# --- Drug and nutrition data
RXNAV_BASE_URL=http://localhost:4000
OPENFDA_API_KEY=
USDA_FDC_API_KEY=
FOOD_PROVIDER=fatsecret
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
OFF_USER_AGENT="RepSight/0.1 (dev@<domain>)"

# --- Weather (V1.0)
WEATHERKIT_KEY_ID=
WEATHERKIT_TEAM_ID=
WEATHERKIT_PRIVATE_KEY=

# --- Payments
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_API_KEY=
REVENUECAT_PUBLIC_SDK_KEY_IOS=
REVENUECAT_PUBLIC_SDK_KEY_ANDROID=

# --- Notifications and email
EXPO_ACCESS_TOKEN=
SES_FROM_ADDRESS=no-reply@localhost

# --- Analytics and observability (empty = disabled)
POSTHOG_API_KEY=
POSTHOG_HOST=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Storage and retention
S3_BUCKET_MEAL_PHOTOS=rs-local-meal-photos
S3_BUCKET_SHARES=rs-local-shares
S3_BUCKET_EXPORTS=rs-local-exports
S3_BUCKET_CONTENT=rs-local-content
MEAL_PHOTO_MAX_AGE_HOURS=24
SHARE_DEFAULT_RETENTION_DAYS=30
SHARE_MAX_RETENTION_DAYS=365
CHAT_RETENTION_MONTHS=18
DELETION_SLA_DAYS=30

# --- App
MIN_APP_VERSION=0.1.0

# --- Studio and CI
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GOLDEN_FIXTURES_URI=s3://rs-research-golden/v1/
