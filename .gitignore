# Secrets (GR-12): only .env.example is committed
.env
.env.*
!.env.example

# Node / pnpm
node_modules/
*.tsbuildinfo
coverage/
dist/
.expo/

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

